# UniBridge Environment Variables

# Supabase (local development uses port 55321 instead of default 54321)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-start
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-start

# AI Provider (optional, falls back to template-based icebreakers)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1  # or GLM endpoint

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
